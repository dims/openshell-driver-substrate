# The stock gateway, for the kind harness: TLS with the harness CA, no user
# authentication, session tokens that do not expire (a supervisor restored
# from a snapshot reconnects with the one it has), the driver on the socket
# the two containers share, and the credential store's key on the database
# volume, so a new pod can read what the old one wrote.
[openshell]
version = 2

[openshell.gateway]
name = "kind"
bind_address = "0.0.0.0:${GATEWAY_PORT}"
health_bind_address = "0.0.0.0:${GATEWAY_HEALTH_PORT}"
log_level = "info"
compute_driver = "substrate"

[openshell.gateway.tls]
cert_path = "/etc/openshell-tls/tls.crt"
key_path = "/etc/openshell-tls/tls.key"

[openshell.gateway.auth]
allow_unauthenticated_users = true

[openshell.gateway.gateway_jwt]
signing_key_path = "/etc/openshell-jwt/signing.pem"
public_key_path = "/etc/openshell-jwt/public.pem"
kid_path = "/etc/openshell-jwt/kid"
gateway_id = "kind"

[openshell.drivers.substrate]
socket_path = "/var/run/openshell-compute/driver/driver.sock"

[openshell.gateway.credential_storage]
# In its own directory: the gateway makes that directory 0700, and the
# volume's root is not its to change.
key_encryption_key_path = "/var/openshell/credentials/key-encryption-key.bin"
