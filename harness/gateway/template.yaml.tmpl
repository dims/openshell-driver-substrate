# The ActorTemplate fragment the driver gives every sandbox: the request's
# image in the sandbox container, the runtime image for the supervisor and the
# relay, both launchers with LAUNCH_URL so the supervisor fetches this actor's
# bundle from the driver. Rendered by gateway-up.sh into the driver's
# ConfigMap. runtime/README.md says what the sandbox image must contain.
containers:
  - name: sandbox
    image: "${RUNTIME_IMAGE}"  # the request's image replaces it
    command: ["python3", "/opt/openshell-substrate/launcher.py", "sandbox"]
    env:
      - name: LAUNCH_URL
        value: "http://${LAUNCH_HOST}:${LAUNCH_PORT}"
    securityContext:
      capabilities:
        drop: ["ALL"]
    volumeMounts:
      - name: socket-dir
        mountPath: "/run/openshell"
      - name: supervisor-ca
        mountPath: "/run/openshell-supervisor-ca"
  # The supervisor keeps its own container: the sandbox's resolver points at
  # the sandbox's relay, and the supervisor's policy DNS needs the actor's
  # resolver for upstream lookups.
  - name: supervisor
    image: "${RUNTIME_IMAGE}"
    command: ["python3", "/opt/openshell-substrate/launcher.py", "supervisor"]
    env:
      - name: LAUNCH_URL
        value: "http://${LAUNCH_HOST}:${LAUNCH_PORT}"
    securityContext:
      capabilities:
        drop: ["ALL"]
    volumeMounts:
      - name: socket-dir
        mountPath: "/run/openshell"
      - name: identity
        mountPath: "/run/ate"
  # Not part of the sandbox. See runtime/relay.py.
  - name: relay
    image: "${RUNTIME_IMAGE}"
    command: ["python3", "/opt/openshell-substrate/relay.py"]
    securityContext:
      capabilities:
        drop: ["ALL"]
resources:
  limits:
    cpuMillicores: 2000
    memoryBytes: 1073741824
volumes:
  - name: socket-dir
    durableDir: {}
  - name: supervisor-ca
    durableDir: {}
  # Who this actor is, correct after a restore from the shared snapshot.
  - name: identity
    systemInfo:
      dataSources:
        - actorMetadata:
            items:
              - field: ACTOR_METADATA_FIELD_NAME
                path: actor-name
              - field: ACTOR_METADATA_FIELD_ATESPACE
                path: atespace
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
