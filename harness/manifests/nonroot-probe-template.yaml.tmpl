# Minimal non-root container: a busybox image whose only distinguishing feature
# is USER 1000:1000. Reproduces the Substrate bugs with no OpenShell parts
# involved, on either sandbox class. See "Generic non-root repro" in the README.
#
# The /busybox prefix is required: a FROM scratch image has no applet symlinks
# and no PATH, so a bare `sleep` does not resolve, the script ends, and the
# container dies before the golden snapshot is taken.
metadata:
  atespace: ${ATESPACE}
  name: nonroot-probe
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS}
  configName: ${SANDBOX_CONFIG_NAME}
snapshotsConfig:
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onResume:
    fromData: RESUME_SOURCE_COLD_BOOT
  storageLocation: "gs://${BUCKET_NAME}/${ATESPACE}/"
containers:
  - name: probe
    image: "${NONROOT_PROBE_IMAGE}"
    args: ["sh", "-c", "echo probe-started; /busybox sleep infinity"]
