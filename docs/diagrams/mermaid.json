    "fontSize": "15px",
    "primaryColor": "#f1f5f9",
    "primaryBorderColor": "#475569",
    "primaryTextColor": "#0f172a",
    "lineColor": "#475569",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8",
    "actorBkg": "#e2e8f0",
    "actorBorder": "#475569",
    "signalColor": "#1e293b",
    "signalTextColor": "#1e293b",
    "noteBkgColor": "#fef9c3",
    "noteBorderColor": "#ca8a04",
    "activationBkgColor": "#dbeafe",
    "activationBorderColor": "#2563eb",
