# The driver's template fragment: what every helpdesk actor is made of. The
# driver adds the name, the atespace and the worker selector; run.sh prepends
# the same for kubectl-ate. The sandbox container's image is the request's.
# Both containers run launcher.py; see its docstring for the two modes.
containers:
  - name: sandbox
    image: "${SANDBOX_IMAGE}"
    command: ["python3", "/opt/helpdesk/launcher.py", "sandbox"]
    securityContext:
      capabilities:
        drop: ["ALL"]
    volumeMounts:
      - name: socket-dir
        mountPath: "/run/openshell"
      - name: supervisor-ca
        mountPath: "/run/openshell-supervisor-ca"
  # The supervisor keeps its own container: the sandbox's resolver points at
  # the sandbox's relay, and the supervisor's policy DNS needs the actor's
  # resolver for upstream lookups.
  - name: supervisor
    image: "${SANDBOX_IMAGE}"
    command: ["python3", "/opt/helpdesk/launcher.py", "supervisor"]
    securityContext:
      capabilities:
        drop: ["ALL"]
    volumeMounts:
      - name: supervisor-files
        mountPath: "/opt/supervisor-files"
      - name: socket-dir
        mountPath: "/run/openshell"
      - name: identity
        mountPath: "/run/ate"
  # Not part of the sandbox. See relay.py.
  - name: relay
    image: "${SANDBOX_IMAGE}"
    command: ["python3", "/opt/helpdesk/relay.py"]
    securityContext:
      capabilities:
        drop: ["ALL"]
# The whole worker's CPU, so alice and bob land on different workers: a
# worker hosts as many actors as fit, and beat 8 kills one worker.
resources:
  limits:
    cpuMillicores: 2000
    memoryBytes: 1073741824
volumes:
  # The supervisor's static files, for the demo without a gateway.
  - name: supervisor-files
    image:
      reference: "${BOOTSTRAP_FILES_IMAGE}"
  - name: socket-dir
    durableDir: {}
  - name: supervisor-ca
    durableDir: {}
  # Who this actor is, correct after a restore from the shared snapshot.
  - name: identity
    systemInfo:
      dataSources:
        - actorMetadata:
            items:
              - field: ACTOR_METADATA_FIELD_NAME
                path: actor-name
              - field: ACTOR_METADATA_FIELD_ATESPACE
                path: atespace
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
