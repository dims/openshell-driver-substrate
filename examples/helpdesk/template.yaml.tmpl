metadata:
  atespace: ${ATESPACE}
  name: ${TEMPLATE}
# The pool these labels select decides the sandbox class (micro-VM).
workerSelector:
  matchLabels:
    workload: openshell-microvm
containers:
  - name: sandbox
    image: "${SANDBOX_IMAGE}"
    # Runs as the image's user from the start; sandbox-entry.sh sets no_new_privs.
    command: ["/opt/helpdesk/sandbox-entry.sh", "/openshell-sandbox"]
    args: ["--bootstrap", "/.openshell/channel/sandbox/bootstrap.json", "--log-level", "info"]
    securityContext:
      capabilities:
        drop: ["ALL"]
    volumeMounts:
      - name: socket-dir
        mountPath: "/run/openshell"
      - name: supervisor-ca
        mountPath: "/run/openshell-supervisor-ca"
  - name: supervisor
    image: "${SUPERVISOR_IMAGE}"
    command: ["/openshell-supervisor"]
    env:
      - name: OPENSHELL_ADMITTED_ISOLATION_BACKEND
        value: "openshell-sandbox"
    args: ["--role","isolation-backend","--sandbox-id","test-sandbox-1",
           "--backend-descriptor-file","/.openshell/supervisor/runtime-descriptor.json",
           "--auth-bundle-file","/.openshell/supervisor/auth.json",
           "--policy-rules","/.openshell/supervisor/policy.rego",
           "--policy-data","/.openshell/supervisor/data.yaml",
           "--log-level","info","--",
           "python3","/opt/helpdesk/agent.py"]
    volumeMounts:
      - name: bootstrap
        mountPath: "/.openshell"
      - name: socket-dir
        mountPath: "/run/openshell"
  # Not part of the sandbox. See relay.py.
  - name: relay
    image: "${SANDBOX_IMAGE}"
    command: ["python3", "/opt/helpdesk/relay.py"]
    securityContext:
      capabilities:
        drop: ["ALL"]
# The whole worker's CPU, so alice and bob land on different workers: a
# worker hosts as many actors as fit, and beat 8 kills one worker.
resources:
  limits:
    cpuMillicores: 2000
    memoryBytes: 1073741824
volumes:
  - name: bootstrap
    image:
      reference: "${BOOTSTRAP_FILES_IMAGE}"
  - name: socket-dir
    durableDir: {}
  - name: supervisor-ca
    durableDir: {}
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
